{
  "name": "crypto-bot-backend",
  "version": "1.0.0",
  "description": "Backend API for crypto trading bot with AI signal recommendations",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "docker:build": "docker build -t crypto-bot-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env crypto-bot-backend",
    "docker:compose": "docker-compose up",
    "docker:compose:detach": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend"
  },
  "keywords": ["crypto", "trading", "bot", "ai", "signals"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.1",
    "axios": "^1.5.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/cors": "^2.8.14",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1"
  }
}
