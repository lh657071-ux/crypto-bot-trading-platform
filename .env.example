# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration (Public Visibility)
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://crypto_user:crypto_password@localhost:5432/crypto_bot
DB_HOST=postgres
DB_PORT=5432
DB_USER=crypto_user
DB_PASSWORD=crypto_password
DB_NAME=crypto_bot

# API Configuration
API_PREFIX=/api
LOG_LEVEL=info

# Security
JWT_SECRET=your-secret-key-change-this-in-production
API_KEY_TRADING=your-api-key-change-this

# Trading Bot Configuration
SIGNALS_UPDATE_INTERVAL=60000
MAX_POSITIONS=10
RISK_LIMIT=0.02
AUTO_TRADE=true
SIGNAL_THRESHOLD=0.65

# External APIs
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret